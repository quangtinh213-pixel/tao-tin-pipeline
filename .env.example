# ─── Video Layout ────────────────────────────────────────────────────────────
# Aspect ratio: 9:16 (vertical/portrait) or 16:9 (horizontal/landscape)
ASPECT_RATIO=9:16

# Theme: dark or light
THEME=dark

# ─── Production Studio AI agent (server-side only) ───────────────────────────
# Create a project API key in the OpenAI Platform dashboard. Never expose this
# value in dashboard JavaScript or commit your local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# ─── TTS: ElevenLabs (primary — highest quality for Vietnamese) ───────────────
ELEVENLABS_API_KEY=
# VieNeu-TTS (local, free). Used first when the template sets vieneuVoice, or TTS_PROVIDER=vieneu / VIENEU_VOICE is set.
# Needs the VieNeu-TTS repo with its .venv at VIENEU_DIR. Voices: Mai Anh, Minh Đức, Thùy Dung, Hải Đăng, Thiện Minh, Minh Triết, ...
# TTS_PROVIDER=vieneu
# VIENEU_VOICE=Thùy Dung
# VIENEU_DIR=~/Documents/VieNeu-TTS
ELEVENLABS_VOICE_ID=K7ewtjKRNtwwt3lKQ6M0

# ─── TTS: Gemini (fallback — used when ELEVENLABS_API_KEY is not set) ────────
# Get API key at: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Achird

# ─── TTS: Edge TTS (last resort — free, no key; needs `pip install edge-tts` + ffmpeg) ─
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# ─── STT: Groq (primary) ─────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ─── STT: api.stt.ai (fallback) ────────────────────────
STT_API_KEY=
STT_LANGUAGE=vi

# ─── Cloudflare Workers AI ───────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─── Pexels ────────────────────
PEXELS_API_KEY=

# ─── Subtitles ────────────────────────────────────────────────────────────────
# Show subtitles overlay on the video. true or false.
SHOW_SUBTITLES=true
# Required when this template uses REMOTION_MAPBOX_TOKEN.
REMOTION_MAPBOX_TOKEN=

# ─── YouTube Upload Integration ──────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Client credentials (YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Video privacy status: public, unlisted, or private (default: public)
YOUTUBE_PRIVACY_STATUS=public
# YouTube Category ID: 25 (News & Politics), 22 (People & Blogs), etc.
YOUTUBE_CATEGORY_ID=25
# Public uploads are scheduled (publishAt) into the next free golden slot, Vietnam time.
# Comma-separated HH:MM list, or "off" to publish immediately.
YOUTUBE_PUBLISH_SLOTS=07:00,07:30,11:30,12:00,12:30,13:00,15:30,16:30,18:00,18:30,19:00,19:30,21:00,21:30,22:00,22:30
# Minimum minutes between two videos going live (default 60).
YOUTUBE_PUBLISH_GAP_MINUTES=60
# Automatically upload right after Step 8 Render completes in /gen-video (true or false)
YOUTUBE_AUTO_UPLOAD=false

# ─── Facebook Reel Upload ────────────────────────────────────────────────────
# Long-lived user token or Page token (pages_show_list, pages_read_engagement, pages_manage_posts)
FB_PAGE_TOKEN=
# Numeric Facebook Page ID to publish Reels to
FB_PAGE_ID=
FB_GRAPH_API=v26.0
# Khung giờ hẹn đăng Reel (giờ VN, mặc định giống YouTube); off = đăng ngay
FB_PUBLISH_SLOTS=
FB_PUBLISH_GAP_MINUTES=120
# Bỏ qua video render quá số giờ này
FB_MAX_AGE_HOURS=24
# Automatically publish a Reel right after Step 8 Render completes in /gen-video (true or false)
FACEBOOK_AUTO_UPLOAD=false


# Telegram notifications for the auto-news scheduler (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
