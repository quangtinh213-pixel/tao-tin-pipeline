{
  "toolPermission": "request-review",
  "artifactReviewPolicy": "always-proceed",
  "permissions": {
    "allow": [
      "command(node)",
      "command(npx remotion)",
      "command(npx playwright)",
      "command(npm run)",
      "command(npm test)",
      "command(ffmpeg)",
      "command(ffprobe)",
      "command(edge-tts)",
      "command(curl)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(grep)",
      "command(find)",
      "command(mkdir)",
      "command(cp)",
      "command(mv)",
      "command(test)",
      "command(date)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "read_url(*)",
      "write_file(/opt/tao-tin)"
    ],
    "deny": [
      "command(sudo)",
      "command(rm -rf /)",
      "command(git push)",
      "command(git reset)",
      "command(ssh)",
      "command(scp)",
      "command(crontab)",
      "command(systemctl)",
      "command(passwd)",
      "command(useradd)",
      "command(chmod 777)",
      "command(npm install)",
      "command(npm i)",
      "command(pip)",
      "command(pip3)",
      "command(apt)",
      "command(apt-get)",
      "write_file(/opt/tao-tin/.env)",
      "write_file(/opt/tao-tin/.git)",
      "write_file(/opt/tao-tin/deploy)",
      "write_file(/root/.ssh)",
      "write_file(/etc)"
    ]
  }
}
